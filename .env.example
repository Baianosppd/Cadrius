# Copie para .env e preencha. NUNCA versionar o .env (já está no .gitignore).
# Gerar segredos:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Chave Fernet:    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Aplicação ---
DEBUG=True                       # False em produção (a app recusa arrancar sem chaves seguras)
DJANGO_ENV=development           # production | staging | development (tag do Sentry)
FRONTEND_URL=http://localhost:5173    # usado nos redirecionamentos do Stripe (em produção: https://app.cadrius.ia.br)
APP_VERSION=dev                  # no deploy = SHA do commit
DJANGO_SECRET_KEY=               # obrigatória em produção
ENCRYPTION_KEY=                  # obrigatória em produção (cifra de credenciais de terceiros)
BLIND_INDEX_KEY=                 # obrigatória em produção (índices de busca dos dados pessoais cifrados; diferente da ENCRYPTION_KEY)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
AXES_PROXY_COUNT=1

# --- Dados ---
POSTGRES_PASSWORD=postgres       # forte em produção
DATABASE_URL=postgres://postgres:postgres@db:5432/cadrius
REDIS_PASSWORD=                  # obrigatória em produção
REDIS_URL=redis://redis:6379/1   # com senha: redis://:SENHA@redis:6379/1

# --- Integrações ---
EVOLUTION_API_GLOBAL_KEY=cadrius_mestre_secreto_123   # obrigatória/forte em produção
# --- IA (CAD-221): configure só as que for usar. Chaves NUNCA em chat, e-mail ou GitHub — só aqui no servidor. ---
# Plano gratuito que treina com os dados (Gemini free, Mistral Experiment, modelos :free do OpenRouter) NÃO recebe dado
# de cliente; marque <PROVEDOR>_PAID=true quando a conta for paga para liberar.
ANTHROPIC_API_KEY=               # Claude
ANTHROPIC_MODEL=                 # padrão claude-opus-5-5 (claude-sonnet-5-5 / claude-haiku-4-5 custam menos)
OPENAI_API_KEY=
OPENAI_MODEL=                    # padrão gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=                    # padrão gemini-2.5-flash
GEMINI_PAID=false
MARKETING_IMAGE_GEMINI_MODEL=     # CAD-231: imagem do marketing (padrão gemini-2.5-flash-image, o "Nano Banana")
MARKETING_VIDEO_GEMINI_MODEL=     # CAD-231: vídeo do marketing (padrão veo-3.1-fast-generate-preview)
GROQ_API_KEY=                    # gratuito com limite; não treina com os dados
GROQ_MODEL=                      # padrão llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_PAID=false
MARITACA_API_KEY=                # Sabiá (empresa brasileira, dados no Brasil)
MARITACA_MODEL=                  # padrão sabia-3.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                # padrão meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_PAID=false
OLLAMA_BASE_URL=                 # modelo local, ex.: http://ollama:11434/v1 (dado não sai do servidor)
OLLAMA_MODEL=                    # padrão qwen2.5:7b-instruct
AI_PROVIDER_ORDER=               # extração/triagem/minuta (barato primeiro). Ex.: GROQ,MARITACA,OPENAI
AI_ASSISTANT_PROVIDER_ORDER=     # assistente (qualidade primeiro). Ex.: ANTHROPIC,OPENAI
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Meios no checkout (CAD-224): card | card,boleto (ative boleto no painel do Stripe antes)
STRIPE_PAYMENT_METHODS=card
MEDIA_ADDON_PRICE_BRL=149.00      # CAD-231: adicional de mídia com IA (mensal) nos planos abaixo do Enterprise
NGROK_AUTHTOKEN=                 # só com: docker compose --profile tunnel up

# --- Produção (docker-compose.prod.yml) ---
APP_HOST=api.cadrius.ia.br
ACME_EMAIL=
DOZZLE_HOST=logs.cadrius.ia.br
DOZZLE_BASIC_AUTH=               # htpasswd -nb admin SENHA   (aspas simples no .env por causa do $)
