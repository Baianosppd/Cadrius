# /etc/cadrius/backup.env  (root:root, chmod 600) — preenchido pelo bootstrap.sh
BACKUP_GPG_RECIPIENT=            # fingerprint da chave PÚBLICA importada
BACKUP_DB_PASSWORD=              # senha do papel somente-leitura cadrius_backup (gerada pelo bootstrap)

# Cópia EXTERNA obrigatória. Exemplo com rclone (S3/Backblaze/Supabase Storage S3/Wasabi...):
#   rclone config  → crie o remote "offsite" → RCLONE_REMOTE=offsite:cadrius-backups
RCLONE_REMOTE=

# Alertas (opcional, recomendado): Discord/Slack webhook OU Telegram (https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>)
ALERT_WEBHOOK_URL=
# Monitor de "backup não rodou" (healthchecks.io ou similar) — um URL por ambiente
HC_PING_URL_PROD=
HC_PING_URL_STAGING=

MIN_FREE_PCT=15
RETENTION_RECENT_DAYS=3
RETENTION_DAILY_DAYS=14
RETENTION_WEEKLY_DAYS=60
RETENTION_MONTHLY_DAYS=400

# Cópia externa — recomendado: chave SÓ DE ESCRITA + Object Lock/versionamento no bucket; então OFFSITE_PRUNE=false
# (a retenção remota é feita pelas regras de ciclo de vida do bucket). Use: sudo deploy/backup/setup-offsite.sh
OFFSITE_PRUNE=true
OFFSITE_MAX_AGE_HOURS=30
