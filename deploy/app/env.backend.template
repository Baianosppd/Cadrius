# /opt/cadrius/@ENV@/.env — gerado por bootstrap.sh (segredos aleatórios). EDITE as chaves de terceiros abaixo.
# Depois de editar:  /opt/cadrius/infra/deploy/scripts/deploy.sh @ENV@

# ---- Identidade do ambiente (usadas pelo compose) ----
ENV_NAME=@ENV@
COMPOSE_PROJECT_NAME=cadrius-@ENV@
APP_HOST=@APP_HOST@
API_HOST=@API_HOST@
DB_USER=@DB_USER@
DB_NAME=@DB_NAME@
DB_PASSWORD_URLENC=@DB_PASSWORD_URLENC@

# ---- Django ----
DEBUG=False
DJANGO_ENV=@DJANGO_ENV@
APP_VERSION=unset
DJANGO_SECRET_KEY=@DJANGO_SECRET_KEY@
ENCRYPTION_KEY=@ENCRYPTION_KEY@
BLIND_INDEX_KEY=@BLIND_INDEX_KEY@
# 127.0.0.1/localhost: o healthcheck do contêiner chama o back por dentro (sem isso o /readyz responde 400)
ALLOWED_HOSTS=@API_HOST@,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://@APP_HOST@
CSRF_TRUSTED_ORIGINS=https://@APP_HOST@,https://@API_HOST@
FRONTEND_URL=https://@APP_HOST@
SECURE_HSTS_SECONDS=31536000
AXES_PROXY_COUNT=1
LOG_LEVEL=INFO
SENTRY_DSN=
# DSN do projeto React (público; vai embutido no build do front)
FRONT_SSO_ENABLED=false
FRONT_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SECURITY_ALERT_EMAILS=
PRIVACY_CONTACT_EMAIL=privacidade@cadrius.ia.br

# ---- Banco (PostgreSQL compartilhado; papel exclusivo deste ambiente) ----
DATABASE_URL=postgres://@DB_USER@:@DB_PASSWORD_URLENC@@postgres:5432/@DB_NAME@

# ---- Redis (exclusivo deste ambiente) ----
REDIS_PASSWORD=@REDIS_PASSWORD@
REDIS_URL=redis://:@REDIS_PASSWORD@@redis:6379/1

# ---- WhatsApp (só se usar o profile whatsapp) ----
EVOLUTION_API_GLOBAL_KEY=@EVOLUTION_KEY@
EVOLUTION_API_BASE_URL=http://evolution-api:8080

# ---- IA (CAD-221/222). Preencha só as que for usar; depois: docker compose up -d --force-recreate web worker ----
# Plano gratuito que treina com os dados (Gemini free, Mistral Experiment, OpenRouter :free) nunca recebe dado de cliente;
# marque <PROVEDOR>_PAID=true quando a conta for paga. Escritórios existentes: python manage.py cadrius_ia_provedores --help
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_PAID=false
# CAD-231: imagem e vídeo do Marketing (adicional de mídia). Vazio = padrão.
MARKETING_IMAGE_GEMINI_MODEL=
MARKETING_VIDEO_GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
MISTRAL_PAID=false
MARITACA_API_KEY=
MARITACA_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PAID=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=
AI_PROVIDER_ORDER=
AI_ASSISTANT_PROVIDER_ORDER=

# ---- Chaves de terceiros (PREENCHER) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Meios no checkout (CAD-224): card | card,boleto (ative boleto no painel do Stripe antes)
STRIPE_PAYMENT_METHODS=card
# CAD-231: preço mensal do adicional "Estúdio de mídia com IA" (incluído no Enterprise)
MEDIA_ADDON_PRICE_BRL=149.00
SUPABASE_URL=
SUPABASE_KEY=

# --- Login social (SSO). Vazios = desligado. Passo a passo: deploy/README.md §9. Um app OAuth por ambiente. ---
API_PUBLIC_URL=https://@API_HOST@
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# CAD-230: "Conectar Google" (Agenda + Planilhas + Documentos) sem o escritório criar app no Google Cloud. Vazio = usa o do login acima.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- E-mail transacional (recuperação de senha etc.). Sem EMAIL_HOST o back NÃO envia e-mail. Preencha no servidor. ---
# Provedor: gmail | brevo | ses | locaweb | custom (troque aqui no futuro; host/porta vêm do preset). Gmail: use SENHA DE APP.
EMAIL_PROVIDER=gmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Gmail só envia com o endereço da própria conta (ou um alias "Enviar como" configurado): ajuste o remetente.
DEFAULT_FROM_EMAIL=Cadrius <no-reply@cadrius.ia.br>

# --- Leitura de documentos (CAD-163). Passo a passo: deploy/README.md §13 ---
DOCUMENT_PIPELINE_ENABLED=True
WITH_OCR=0
CLAMAV_HOST=
CLAMAV_PORT=3310
DOCUMENT_MAX_BYTES=26214400

# Verificação em duas etapas (CAD-169): equipe Cadrius sempre exige. True = exige também de donos/admins de escritório.
MFA_REQUIRED_FOR_MANAGERS=False
