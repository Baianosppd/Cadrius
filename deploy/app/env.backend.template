# /opt/cadrius/@ENV@/.env — gerado por bootstrap.sh (segredos aleatórios). EDITE as chaves de terceiros abaixo.
# Depois de editar:  /opt/cadrius/infra/deploy/scripts/deploy.sh @ENV@

# ---- Identidade do ambiente (usadas pelo compose) ----
ENV_NAME=@ENV@
COMPOSE_PROJECT_NAME=cadrius-@ENV@
APP_HOST=@APP_HOST@
API_HOST=@API_HOST@
DB_USER=@DB_USER@
DB_NAME=@DB_NAME@
DB_PASSWORD_URLENC=@DB_PASSWORD_URLENC@

# ---- Django ----
DEBUG=False
DJANGO_ENV=@DJANGO_ENV@
APP_VERSION=unset
DJANGO_SECRET_KEY=@DJANGO_SECRET_KEY@
ENCRYPTION_KEY=@ENCRYPTION_KEY@
ALLOWED_HOSTS=@API_HOST@
CORS_ALLOWED_ORIGINS=https://@APP_HOST@
CSRF_TRUSTED_ORIGINS=https://@APP_HOST@,https://@API_HOST@
FRONTEND_URL=https://@APP_HOST@
SECURE_HSTS_SECONDS=31536000
AXES_PROXY_COUNT=1
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SECURITY_ALERT_EMAILS=
PRIVACY_CONTACT_EMAIL=privacidade@cadrius.ia.br

# ---- Banco (PostgreSQL compartilhado; papel exclusivo deste ambiente) ----
DATABASE_URL=postgres://@DB_USER@:@DB_PASSWORD_URLENC@@postgres:5432/@DB_NAME@

# ---- Redis (exclusivo deste ambiente) ----
REDIS_PASSWORD=@REDIS_PASSWORD@
REDIS_URL=redis://:@REDIS_PASSWORD@@redis:6379/1

# ---- WhatsApp (só se usar o profile whatsapp) ----
EVOLUTION_API_GLOBAL_KEY=@EVOLUTION_KEY@
EVOLUTION_API_BASE_URL=http://evolution-api:8080

# ---- Chaves de terceiros (PREENCHER) ----
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_KEY=
