# SPA (React Router) + cabeçalhos de segurança (snippet gerado de security-headers.inc.template com ${API_ORIGIN}).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok"; }

    # Arquivos com hash (Vite): 1 ano. O index.html nunca é cacheado (senão o deploy não aparece).
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    # Web Worker do react-pdf (.mjs): alguns mime.types o servem como text/plain e o navegador recusa o módulo.
    location ~* ^/assets/.+\.mjs$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        types { }
        default_type application/javascript;
        try_files $uri =404;
    }
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
