# SPA (React Router) + cabeçalhos de segurança (snippet gerado de security-headers.inc.template com ${API_ORIGIN}).

# SEO: só app.cadrius.ia.br (produção) é indexável. Teste (app-teste) e qualquer outro host ficam fora do Google.
map $host $seo_indexable_host {
    app.cadrius.ia.br 1;
    default           0;
}
# X-Robots-Tag por URL (vazio = cabeçalho não é enviado). Usa $request_uri porque o try_files troca $uri por /index.html.
# Mesma lista de páginas públicas de src/seo/seo.js; telas logadas e links com token (/portal, /captacao...) = noindex.
map "$seo_indexable_host$request_uri" $seo_robots {
    default "noindex, nofollow";
    "~^1/(criar-conta|cadastro/individual|cadastro/empresa|esqueceu-a-senha)?/?(\?.*)?$" "";
    "~^1/(assets/|[^/?]+\.(png|svg|ico|xml|txt|json|webmanifest)(\?|$))" "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    gzip on;
    gzip_vary on;
    gzip_types text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml image/x-icon;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok"; }

    # Ambiente de teste: robots.txt bloqueia tudo; produção serve public/robots.txt
    location = /robots.txt {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        default_type text/plain;
        if ($seo_indexable_host = 0) { return 200 "User-agent: *\nDisallow: /\n"; }
        try_files $uri =404;
    }

    # Arquivos com hash (Vite): 1 ano. O index.html nunca é cacheado (senão o deploy não aparece).
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    # Web Worker do react-pdf (.mjs): alguns mime.types o servem como text/plain e o navegador recusa o módulo.
    location ~* ^/assets/.+\.mjs$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        types { }
        default_type application/javascript;
        try_files $uri =404;
    }
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
