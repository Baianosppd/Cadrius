# Gerado/preenchido por deploy/bootstrap.sh (não versionar o .env real).
ROOT_DOMAIN=cadrius.ia.br
ACME_EMAIL=
# Para TESTAR DNS/TLS sem estourar o limite do Let's Encrypt, use o servidor de homologação:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

POSTGRES_SUPERUSER_PASSWORD=
# senha BasicAuth do Dozzle (hash bcrypt gerado por htpasswd -nbB admin SENHA; $ vira $$ no .env)
DOZZLE_BASIC_AUTH=

# Ajuste do PostgreSQL conforme a RAM (bootstrap calcula; valores para 4 GB)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100
PG_MEM_LIMIT=2048M
