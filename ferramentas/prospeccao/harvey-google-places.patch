+"""Portuguese (Brazil) opt-outs: the footer asks for "não, obrigado", and the
+usual ways of asking to be taken off a list always stop the sequence."""
+import pytest
+
+from harvey.agents.handler import _opt_out_reason
+from harvey.config import ComplianceConfig
+
+
+@pytest.mark.parametrize("reply", [
+    "Não, obrigado.",
+    "nao obrigada",
+    "Não, obrigado. Att, Dra. Ana",
+    "Por favor, me remova da lista.",
+    "Quero me descadastrar",
+    "Parem de me enviar esses e-mails",
+    "Não me mandem mais nada",
+    "não quero receber",
+    "SAIR",
+    "Pode tirar-me? Remova-me, obrigado",
+])
+def test_portuguese_opt_outs_are_honoured(reply):
+    assert _opt_out_reason(reply, reply) is not None
+
+
+@pytest.mark.parametrize("reply", [
+    "Tenho interesse sim, pode mandar o link do teste?",
+    "Se não, obrigado de qualquer forma; me liga amanhã",
+    "Não, obrigado pela ajuda com o prazo: era isso que eu precisava",
+    "Vocês integram com o PJe? Se não, como fica?",
+])
+def test_ordinary_portuguese_replies_are_not_opt_outs(reply):
+    assert _opt_out_reason(reply, reply) is None
+
+
+def test_portuguese_opt_out_line_is_accepted():
+    line = 'Se não fizer sentido para você, responda "não, obrigado" e eu não envio mais.'
+    assert ComplianceConfig(opt_out_line=line).opt_out_line == line
+    assert ComplianceConfig(opt_out_line="Para não receber mais, responda SAIR.").opt_out_line
