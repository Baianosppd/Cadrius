         tinyfish_api_key=os.getenv("TINYFISH_API_KEY", "").strip(),
         reoon_api_key=os.getenv("REOON_API_KEY", "").strip(),
         zerobounce_api_key=os.getenv("ZEROBOUNCE_API_KEY", "").strip(),
diff --git a/tests/test_discover.py b/tests/test_discover.py
index 46cd728..e7f5940 100644
--- a/tests/test_discover.py
+++ b/tests/test_discover.py
@@ -1743,3 +1743,105 @@ async def test_osm_maps_spanish_business_terms():
     assert provider._tags("comercio al mayor") == ["shop=wholesale"]
     assert provider._tags("mayorista") == ["shop=wholesale"]
     assert provider._tags("mayor's office") == []
+
+
+def _places_page(start, n, token=""):
+    page = {"places": [
+        {"id": f"ChIJ{start + i}", "displayName": {"text": f"Advocacia {start + i}", "languageCode": "pt"},
+         "formattedAddress": "Av. Paulista, 1000 - São Paulo - SP", "nationalPhoneNumber": "(11) 3000-0000",
+         "websiteUri": f"https://adv{start + i}.example/", "rating": 4.8, "userRatingCount": 31,
+         "primaryTypeDisplayName": {"text": "Advogado"}, "businessStatus": "OPERATIONAL"}
+        for i in range(n)]}
+    if token:
+        page["nextPageToken"] = token
+    return page
+
+
+@pytest.mark.asyncio
+async def test_google_places_adapter():
+    provider = D.GooglePlaces()
+    seen = []
+    payload = {"places": [
+        {"id": "ChIJabc", "displayName": {"text": "Souza Advocacia"},
+         "formattedAddress": "Rua A, 10 - Centro, Curitiba - PR", "nationalPhoneNumber": "(41) 3333-4444",
+         "websiteUri": "https://www.souzaadv.com.br/?utm_source=gbp", "rating": 4.9, "userRatingCount": 57,
+         "primaryTypeDisplayName": {"text": "Advogado"}, "businessStatus": "OPERATIONAL",
+         "googleMapsUri": "https://maps.google.com/?cid=1"},
+        {"id": "ChIJnosite", "displayName": {"text": "Dra. Ana Lima"}, "businessStatus": "OPERATIONAL"},
+        {"id": "ChIJclosed", "displayName": {"text": "Fechado Advogados"}, "businessStatus": "CLOSED_PERMANENTLY"},
+    ]}
+
+    def handler(request):
+        seen.append((str(request.url), request.headers.get("x-goog-api-key"),
+                     request.headers.get("x-goog-fieldmask"), json.loads(request.content)))
+        return httpx.Response(200, json=payload)
+
+    env = {"google_places_api_key": "k", "google_places_language": "pt-BR", "google_places_region": "BR"}
+    async with _client(handler) as client:
+        out = await provider.fetch(client, env, D.DiscoveryQuery(
+            term="advogado trabalhista", location="Curitiba, PR", coordinate="-25.43,-49.27,80"))
+
+    url, key, mask, body = seen[0]
+    assert url == "https://places.googleapis.com/v1/places:searchText"
+    assert key == "k"
+    assert "places.websiteUri" in mask and "nextPageToken" in mask
+    assert body == {"textQuery": "advogado trabalhista Curitiba, PR", "pageSize": 20, "languageCode": "pt-BR",
+                    "regionCode": "BR", "locationBias": {"circle": {
+                        "center": {"latitude": -25.43, "longitude": -49.27}, "radius": 50000}}}
+    assert len(seen) == 1, "no nextPageToken = last page"
+    assert provider.last_cost == pytest.approx(0.035)
+
+    souza, ana = out          # the closed office is dropped
+    assert souza.domain == "souzaadv.com.br"
+    assert souza.phone == "(41) 3333-4444" and souza.category == "Advogado"
+    assert souza.rating == 4.9 and souza.review_count == 57
+    assert souza.external_id == "gmaps:ChIJabc" and souza.source_url == "https://maps.google.com/?cid=1"
+    assert souza.maps_rank is None and souza.rank is None and souza.is_claimed is None
+    assert ana.has_website is False and ana.identity() == "gmaps:ChIJnosite"
+
+
+@pytest.mark.asyncio
+async def test_google_places_follows_page_tokens_and_stops_at_three_pages():
+    bodies = []
+    pages = [_places_page(0, 20, "t1"), _places_page(20, 20, "t2"), _places_page(40, 20, "t3")]
+
+    def handler(request):
+        bodies.append(json.loads(request.content))
+        return httpx.Response(200, json=pages[len(bodies) - 1])
+
+    provider = D.GooglePlaces()
+    async with _client(handler) as client:
+        out = await provider.fetch(client, {"google_places_api_key": "k"},
+                                   D.DiscoveryQuery(term="advogado", location="Recife, PE", limit=200))
+    assert len(out) == 60 and len(bodies) == 3
+    assert "pageToken" not in bodies[0] and bodies[1]["pageToken"] == "t1" and bodies[2]["pageToken"] == "t2"
+    assert "locationBias" not in bodies[0] and "regionCode" not in bodies[0]
+    assert provider.estimate([D.DiscoveryQuery(term="a", limit=200)]) == pytest.approx(3 * 0.035)
+
+
+@pytest.mark.asyncio
+async def test_google_places_refused_key_stops_the_run():
+    def handler(request):
+        return httpx.Response(403, json={"error": {"message": "secret echo k"}})
+
+    provider = D.GooglePlaces()
+    async with _client(handler) as client:
+        with pytest.raises(D.ProviderExhausted) as e:
+            await provider.fetch(client, {"google_places_api_key": "k"}, D.DiscoveryQuery(term="advogado"))
+    assert "403" in str(e.value) and "secret" not in str(e.value)
+    assert provider.last_cost == 0
+
+
+@pytest.mark.asyncio
+async def test_google_places_respects_the_budget():
+    provider = D.GooglePlaces()
+    provider.remaining_budget = 0.05          # one request fits, the second does not
+
+    def handler(request):
+        return httpx.Response(200, json=_places_page(0, 20, "t1"))
+
+    async with _client(handler) as client:
+        out = await provider.fetch(client, {"google_places_api_key": "k"},
+                                   D.DiscoveryQuery(term="advogado", limit=60))
+    assert len(out) == 20 and provider.complete is False
+    assert "budget" in provider.stop_reason
-- 
2.43.0


From 9444dfddccdfce1c94d2252d5de08bc730d7b9ba Mon Sep 17 00:00:00 2001
From: Cadrius <noreply@anthropic.com>
