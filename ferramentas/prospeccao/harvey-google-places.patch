Subject: [PATCH 2/2] Recognise Portuguese (Brazil) opt-outs

---
 harvey/agents/handler.py         | 30 ++++++++++++++++++++++++-
 harvey/config.py                 |  8 +++++--
 tests/test_portuguese_opt_out.py | 38 ++++++++++++++++++++++++++++++++
 3 files changed, 73 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_portuguese_opt_out.py

diff --git a/harvey/agents/handler.py b/harvey/agents/handler.py
index 840cf39..b419abc 100644
--- a/harvey/agents/handler.py
+++ b/harvey/agents/handler.py
@@ -83,9 +83,12 @@ NO_THANKS_RE = re.compile(
 BARE_OPT_OUTS = {"stop", "unsubscribe", "remove", "remove me", "opt out",
                  "no thanks", "no thank you", "baja", "no gracias", "de baja", "dar de baja",
                  "darme de baja",
+                 "sair", "descadastrar", "descadastre", "remover", "me remova", "pare",
+                 "não obrigado", "não obrigada", "nao obrigado", "nao obrigada",
                  "הסר", "הסירו", "הסירי", "תסיר", "תסירו", "להסיר", "הסרה", "להסרה"}
 # Said around a bare opt-out without changing it ("הסר בבקשה", "הסר, תודה").
-_BARE_COURTESIES = {"בבקשה", "נא", "תודה", "רבה", "por", "favor", "gracias", "saludos"}
+_BARE_COURTESIES = {"בבקשה", "נא", "תודה", "רבה", "por", "favor", "gracias", "saludos",
+                    "att", "atenciosamente", "abs", "abraço", "abraços"}
 _MOBILE_SIGNATURE_RE = re.compile(
     r"^[ \t\u200e\u200f]*(?:sent from my \w[^\n]*|get outlook for \w[^\n]*"
     r"|sent from \w+ mail[^\n]*|נשלח מ[^\n]*|קבל(?:ו)? את outlook[^\n]*"
@@ -224,6 +227,23 @@ SPANISH_NO_THANKS_RE = re.compile(
     r"\bno,?[ \t]+(?:muchas[ \t]+)?gracias\b(?![ \t]+(?:a|por)\b)")
 
 
+# Portuguese (Brazil), matched accent-free like the Spanish: "não, obrigado"
+# as the opt-out line asks, and the usual ways to ask to be taken off.
+# Not "se não, obrigado" or "ou não", and not "não, obrigado pela ajuda"
+# answering a question.
+PORTUGUESE_NO_THANKS_RE = re.compile(
+    r"(?<!\bou )(?<!\bse )(?<!porque )(?<!ainda )"
+    r"\bnao,?[ \t]+(?:muito[ \t]+)?obrigad[oa]s?\b(?![ \t]+(?:a|por|pel[oa]s?)\b)")
+PORTUGUESE_OPT_OUT_RE = re.compile(
+    r"(?<!\w)(?:descadastr\w*"
+    r"|(?:me|nos)[ \t]+(?:remova|removam|tire|tirem|retire|retirem|exclua|excluam)\b"
+    r"|(?:remova|removam|tire|tirem|retire|retirem|exclua|excluam)-?(?:me|nos)\b"
+    r"|(?:pare|parem|para)[ \t]+de[ \t]+(?:me[ \t]+|nos[ \t]+)?(?:enviar|mandar|escrever|contatar)\b"
+    r"|nao[ \t]+(?:me[ \t]+|nos[ \t]+)?(?:envie|enviem|mande|mandem|escreva|escrevam)[ \t]+mais\b"
+    r"|nao[ \t]+quero[ \t]+(?:mais[ \t]+)?receber\b"
+    r"|sair[ \t]+da[ \t]+(?:sua[ \t]+)?lista\b)")
+
+
 def _no_accents(text: str) -> str:
     """Accents dropped, for matching Spanish typed with or without them. Only
     Latin letters: combining marks are what spell Hebrew and others' words."""
@@ -337,12 +357,20 @@ def _opt_out_reason(their_text: str, own_words: str) -> dict | None:
         return {"rule": "phrase", "matched": m.group(0),
                 "why": f'Their reply contains "{m.group(0)}".'}
     m = _spanish_opt_out(_spanish_lines(their_text))
+    if m:
+        return {"rule": "phrase", "matched": m.group(0),
+                "why": f'Their reply contains "{m.group(0)}".'}
+    m = PORTUGUESE_OPT_OUT_RE.search(_spanish_lines(their_text))
     if m:
         return {"rule": "phrase", "matched": m.group(0),
                 "why": f'Their reply contains "{m.group(0)}".'}
     for line in their_text.split("\n"):
         line = _flat(line)
         m = SPANISH_NO_THANKS_RE.search(_no_accents(line))
+        if m:
+            return {"rule": "no_thanks", "matched": m.group(0),
+                    "why": f'Their reply says "{m.group(0)}" (no thanks).'}
+        m = PORTUGUESE_NO_THANKS_RE.search(_no_accents(line))
         if m:
             return {"rule": "no_thanks", "matched": m.group(0),
                     "why": f'Their reply says "{m.group(0)}" (no thanks).'}
diff --git a/harvey/config.py b/harvey/config.py
index f6a0921..fcd1d95 100644
--- a/harvey/config.py
+++ b/harvey/config.py
@@ -429,9 +429,13 @@ OPT_OUT_WORDS = ("no thanks", "no thank you", "unsubscribe", "stop", "remove me"
 HEBREW_OPT_OUT_WORDS = ("הסר", "הסירו", "הסרה", "לא תודה", "הסירו אותי", "תורידו אותי")
 # The same in Spanish ('Responda "no, gracias"', 'Responda BAJA').
 SPANISH_OPT_OUT_WORDS = ("no gracias", "baja", "darme de baja")
+# The same in Portuguese ('responda "não, obrigado"', 'responda SAIR').
+PORTUGUESE_OPT_OUT_WORDS = ("não obrigado", "não obrigada", "nao obrigado", "nao obrigada",
+                            "sair", "descadastrar")
 _OPT_OUT_WORD_RE = "(?:" + "|".join(
     r"[\s,]+".join(map(re.escape, w.split()))
-    for w in OPT_OUT_WORDS + HEBREW_OPT_OUT_WORDS + SPANISH_OPT_OUT_WORDS) + ")"
