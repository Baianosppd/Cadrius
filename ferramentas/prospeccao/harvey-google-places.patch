From: Cadrius <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 12:51:58 +0000
Subject: [PATCH 1/2] Add Google Places API (New) discovery provider

---
 .env.example                  |  11 +++
 harvey/collectors/discover.py | 176 ++++++++++++++++++++++++++++++++++
 harvey/config.py              |   6 ++
 tests/test_discover.py        | 102 ++++++++++++++++++++
 4 files changed, 295 insertions(+)

diff --git a/.env.example b/.env.example
index 6e7b36f..9ce8ee8 100644
--- a/.env.example
+++ b/.env.example
@@ -143,6 +143,17 @@ SERPER_API_KEY=
 # Pick scavio_maps or scavio_search in `harvey discover`.
 SCAVIO_API_KEY=
 
+# Google Places API (New) — Google Maps businesses from Google's official API.
+# Where to get it: https://console.cloud.google.com → APIs & Services → enable
+# "Places API (New)" → Credentials → Create API key → restrict it to that API.
+# Billing must be on. Cost: phone and website make each request "Text Search
+# Enterprise": 1,000 requests a month free, then about $35 per 1,000. One
+# request = one page of up to 20 places (3 pages max per search).
+# Pick google_places in `harvey discover`.
+GOOGLE_PLACES_API_KEY=
+GOOGLE_PLACES_LANGUAGE=         # e.g. pt-BR (results' language)
+GOOGLE_PLACES_REGION=           # e.g. BR (two-letter country code)
+
 # TinyFish — web search for discovery and Scout. Records no search rank.
 # Where to get it: https://agent.tinyfish.ai/api-keys
 # Cost: free, no card. Limits: 30 searches a minute, 500 an hour.
diff --git a/harvey/collectors/discover.py b/harvey/collectors/discover.py
index 2b6aadb..8ef6152 100644
--- a/harvey/collectors/discover.py
+++ b/harvey/collectors/discover.py
@@ -1401,6 +1401,181 @@ class ScavioMaps(ScavioProvider):
         return out
 
 
+class GooglePlaces(DiscoveryProvider):
+    """Google's own Places API (New) Text Search: the official way to list
+    businesses from Google Maps, with no scraping.
+
+    Phone and website put every request in the Text Search Enterprise SKU
+    (1,000 requests a month free, then about $35 per 1,000). One request is one
+    page of up to 20 places; a search returns at most 3 pages. Results come in
+    the searcher's language and region (``GOOGLE_PLACES_LANGUAGE``,
+    ``GOOGLE_PLACES_REGION``), so a Brazilian market gets Portuguese categories.
+    """
+
+    key = "google_places"
+    needs_coordinates = True
+    label = "Google Places API"
+    kind = "listings"
+    blurb = ("Google Maps businesses through Google's official Places API: "
+             "phone, website, category, rating and review count. Up to 60 "
+             "businesses per search.")
+    cost_note = "1 request per page (up to 20 places); $0.035/request after 1,000 free a month"
+    free_tier = "1,000 requests a month free (Text Search Enterprise)"
+    signup_url = "https://console.cloud.google.com/apis/library/places.googleapis.com"
+    env_keys = ("google_places_api_key",)
+    caveat = ("Needs a Google Cloud project with billing on and the Places API "
+              "(New) enabled; restrict the key to that API. Claimed status is "
+              "not in the API, so the unclaimed-listing signal stays empty.")
+
+    API = "https://places.googleapis.com/v1/places:searchText"
+    REQUEST_PRICE = 0.035
+    PAGE_SIZE = 20
+    MAX_PAGES = 3                # the API stops at 60 results
+    MAX_RADIUS_M = 50_000        # locationBias circle limit
+    FIELDS = ",".join([
+        "places.id", "places.displayName", "places.formattedAddress",
+        "places.nationalPhoneNumber", "places.internationalPhoneNumber",
+        "places.websiteUri", "places.rating", "places.userRatingCount",
+        "places.primaryTypeDisplayName", "places.businessStatus",
+        "places.googleMapsUri", "nextPageToken",
+    ])
+
+    def _page_count(self, query: DiscoveryQuery) -> int:
+        return max(1, min(self.MAX_PAGES, -(-query.limit // self.PAGE_SIZE)))
+
+    def estimate(self, queries):
+        return sum(self.REQUEST_PRICE * self._page_count(q) for q in queries)
+
+    @classmethod
+    def location_bias(cls, coordinate: str) -> dict | None:
+        """"-23.55,-46.63,40" -> a circle of 40 km (at most 50 km) around it."""
+        parts = [p.strip() for p in (coordinate or "").split(",")]
+        try:
+            lat, lng = float(parts[0]), float(parts[1])
+        except (IndexError, ValueError):
+            return None
+        if not (-90 <= lat <= 90 and -180 <= lng <= 180):
+            return None
+        try:
+            radius_km = float(parts[2]) if len(parts) > 2 and parts[2] else 40.0
+        except ValueError:
+            radius_km = 40.0
+        if not math.isfinite(radius_km) or radius_km <= 0:
+            radius_km = 40.0
+        radius = min(radius_km * 1000, cls.MAX_RADIUS_M)
+        return {"circle": {"center": {"latitude": lat, "longitude": lng}, "radius": radius}}
+
+    async def _post(self, client, env, body: dict) -> dict:
+        if self.last_cost + self.REQUEST_PRICE > self.remaining_budget + 1e-12:
+            raise ProviderExhausted("Google Places: budget reached before the next page")
+        try:
+            r = await client.post(self.API, json=body, headers={
+                "X-Goog-Api-Key": env["google_places_api_key"],
+                "X-Goog-FieldMask": self.FIELDS,
+                "Content-Type": "application/json",
+            })
+        except httpx.HTTPError:
+            raise RuntimeError("Google Places: request failed; try again later") from None
+        # Never put response bodies in logs: upstream errors may echo the key.
+        if r.status_code in (401, 403, 429):
+            reasons = {401: "invalid API key", 403: "key refused (API not enabled, "
+                       "billing off or key restricted)", 429: "quota or rate limit reached"}
+            raise ProviderExhausted(f"Google Places {r.status_code}: {reasons[r.status_code]}")
+        if r.status_code >= 400:
+            raise RuntimeError(f"Google Places {r.status_code}: request failed")
+        self.last_cost += self.REQUEST_PRICE
+        try:
+            data = r.json()
+        except ValueError:
+            raise RuntimeError("Google Places: invalid JSON response") from None
+        if not isinstance(data, dict):
+            raise RuntimeError("Google Places: invalid response")
+        return data
+
+    async def fetch(self, client, env, query):
+        self.last_cost = 0.0
+        self.last_error = self.stop_reason = ""
+        self.complete = True
+        bias = self.location_bias(query.coordinate) if query.coordinate else None
+        body = {
+            # The circle only biases; the place name keeps results in the city.
+            "textQuery": query.keyword(),
+            "pageSize": self.PAGE_SIZE,
+            "languageCode": env.get("google_places_language") or "en",
+        }
+        region = env.get("google_places_region") or ""
+        if region:
+            body["regionCode"] = region
+        if bias:
+            body["locationBias"] = bias
+
+        out: list[Business] = []
+        token = ""
+        for page in range(self._page_count(query)):
+            try:
+                data = await self._post(client, env, dict(body, pageToken=token) if token else body)
+                places = data.get("places") or []
+                if not isinstance(places, list) or any(not isinstance(p, dict) for p in places):
+                    raise RuntimeError("Google Places: invalid results list")
+            except Exception as e:
+                self.complete = False
+                self.last_error = str(e)
+                if isinstance(e, ProviderExhausted):
+                    self.stop_reason = str(e)
+                if not out:
+                    raise
+                logger.warning("%s: page %d of %r failed, keeping %d results: %s",
+                               self.key, page + 1, query.keyword(), len(out), e)
+                break
+            for place in places:
+                business = self._business(place, query)
+                if business:
+                    out.append(business)
+            token = data.get("nextPageToken") or ""
+            if not token or not isinstance(token, str):
+                break
+        return out
+
+    def _business(self, place: dict, query: DiscoveryQuery) -> Business | None:
+        def text(value) -> str:
+            if isinstance(value, dict):
+                value = value.get("text")
+            return value.strip() if isinstance(value, str) else ""
+
+        def number(value, kind):
+            if isinstance(value, bool) or not isinstance(value, (int, float)):
+                return None
+            if not math.isfinite(value) or value < 0:
+                return None
+            return kind(value)
+
+        name = text(place.get("displayName"))
+        status = place.get("businessStatus")
+        if not name or status in ("CLOSED_PERMANENTLY", "CLOSED_TEMPORARILY"):
+            return None
+        site = text(place.get("websiteUri"))
+        place_id = text(place.get("id"))
+        return Business(
+            name=name,
+            domain=normalize_domain(site),
+            website=site,
+            phone=text(place.get("nationalPhoneNumber")) or text(place.get("internationalPhoneNumber")),
+            address=text(place.get("formattedAddress")),
+            location=query.location,
+            category=text(place.get("primaryTypeDisplayName")),
+            rating=number(place.get("rating"), float),
+            review_count=number(place.get("userRatingCount"), int),
+            has_website=bool(site),
+            # Text Search orders by relevance, not by the Maps app's ranking:
+            # no MAPS_RANK signal from it (Harvey would write about a rank
+            # nobody sees).
+            external_id=f"gmaps:{place_id}" if place_id else "",
+            source_url=text(place.get("googleMapsUri")) or (
+                f"https://www.google.com/maps/place/?q=place_id:{place_id}" if place_id else site),
+            provider=self.key,
+        )
+
+
 class ScavioSearch(ScavioProvider):
     """Google organic results with rank, from the same key as Scavio Maps."""
 
@@ -1465,6 +1640,7 @@ PROVIDERS: dict[str, DiscoveryProvider] = {
         Serper(),
         ScavioMaps(),
         ScavioSearch(),
+        GooglePlaces(),
     )
 }
 
diff --git a/harvey/config.py b/harvey/config.py
index 3233254..f6a0921 100644
--- a/harvey/config.py
+++ b/harvey/config.py
@@ -739,6 +739,9 @@ class EnvConfig(BaseModel):
